# Copy with `npm run init-env` (generates MASTER_KEY + APP_PASSPHRASE for you).
# Never commit the real .env.

# --- server ---
NODE_ENV=production
# Keep 127.0.0.1 and expose through an HTTPS tunnel/reverse proxy (see docs/iphone-setup.md).
HOST=127.0.0.1
PORT=8787
# Public HTTPS origin (required for ChatGPT/MCP OAuth and secure cookies), e.g. https://music.example.com
PUBLIC_BASE_URL=
DATABASE_PATH=./data/companion.sqlite
USER_TIMEZONE=America/New_York
LOG_LEVEL=info

# --- secrets ---
# 32 random bytes, base64. Encrypts stored YouTube Music credentials. Losing it = reconnect.
MASTER_KEY=
# Login passphrase for the PWA and the OAuth consent screen (>= 12 chars).
APP_PASSPHRASE=

# --- YouTube Music ---
# ytmusic = real account via ytmusicapi adapter; mock = fictional demo catalog
MUSIC_PROVIDER=ytmusic
# Python with ytmusicapi installed (see adapter/requirements.txt). A venv path is fine: ./.venv/bin/python
PYTHON_BIN=./.venv/bin/python
YTM_ADAPTER_PATH=./adapter/ytm_adapter.py
YTM_MIN_INTERVAL_MS=350

# --- LLM (pick one, or none for rule-based mode) ---
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (beta). "off" to disable.
ANTHROPIC_FALLBACKS=default
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
