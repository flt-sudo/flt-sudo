# --- Supabase (dashboard auth + reads under RLS) ---------------------------
# Project Settings → API. The anon/publishable key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# (newer projects) NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY can be used instead of the anon key.

# --- Discovery pipeline database (server only) -----------------------------
# Project Settings → Database → Connection string. Use the transaction pooler
# (port 6543) on serverless hosts. This role bypasses RLS: never expose it.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Scheduling -------------------------------------------------------------
# Shared secret for /api/cron/scan (min 16 chars). Vercel Cron sends it automatically
# as "Authorization: Bearer $CRON_SECRET" when this variable is set in the project.
CRON_SECRET=
# Public base URL; used in notifications and by the self-hosted scheduler.
APP_URL=http://localhost:3000

# --- X API (live discovery) -------------------------------------------------
# App-only bearer token from developer.x.com with access to GET /2/tweets/search/recent.
# Leave empty to use the mock provider only.
X_BEARER_TOKEN=
# Optional override (e.g. for a proxy or test double).
# X_API_BASE_URL=https://api.x.com

# --- Optional: LLM second opinion -------------------------------------------
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# --- Optional: scan notifications (Slack/Discord-compatible incoming webhook, https only)
# NOTIFY_WEBHOOK_URL=

# LOG_LEVEL=info
