{
  "name": "yt-music-companion",
  "version": "0.1.0",
  "description": "Personal AI YouTube Music companion: taste profile, AI playlists, iPhone PWA, MCP for ChatGPT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "build:web": "vite build",
    "test": "vitest run",
    "test:py": "python3 -m unittest discover -s adapter -p \"test_*.py\"",
    "init-env": "tsx scripts/init-env.ts",
    "import:takeout": "tsx scripts/import-takeout.ts",
    "migrate": "tsx scripts/migrate.ts",
    "icons": "tsx scripts/make-icons.ts",
    "demo": "MUSIC_PROVIDER=mock tsx src/server.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "kysely": "^0.29.7",
    "openai": "^7.43.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
