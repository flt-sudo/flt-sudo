    "decision_usefulness": {
      "pass": true,
      "findings": [
        {
          "gate": "decision_usefulness",
          "severity": "minor",
          "source": "reviewer",
          "detail": "D3 [practicalImplications item 1; furtherResearch item 1; edgeCasesAndFailureModes item 7; verdict paragraph 2] The status-quo threshold is given inconsistently. The verdict and the status-quo alternative say 'below roughly 42-43%'. practicalImplications item 1, furtherResearch item 1 and the edge case say 'below about 35-42%'. furtherResearch item 1 then says 'between about 42-43% and 44.3%' in the next sentence. '35-42%' mixes the before-support line (35%) with the with-support carve-out floor (41.7%), so the reader cannot tell which floor is the stopping rule. The draft should state one rule: 41.7% or 43.3% with a carve-out and support (K42, K50), and 53.3% without a carve-out (K51)."
        }
      ]
    },
